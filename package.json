{
  "name": "soundsible-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run docs:prepare && astro dev",
    "build": "npm run docs:prepare && astro check && astro build && pagefind --site dist && node scripts/check-site.mjs",
    "test": "vitest run src scripts",
    "preview": "astro preview",
    "astro": "astro",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arzuparreta/soundsible.github.io.git"
  },
  "homepage": "https://arzuparreta.github.io/soundsible.github.io/",
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "astro": "^5.18.0",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.5.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.19",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
