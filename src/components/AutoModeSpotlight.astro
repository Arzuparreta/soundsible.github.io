---
import { REPO_URL } from "../constants";
---

<section
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  aria-labelledby="auto-heading"
>
  <div class="grid items-center gap-12 lg:grid-cols-[0.88fr_1.12fr]">
    <div data-reveal>
      <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
        Auto Mode · Beta
      </p>
      <h2
        id="auto-heading"
        class="mt-4 font-display text-3xl font-semibold tracking-tight text-main sm:text-4xl"
      >
        Not shuffle with a crossfade. An actual Auto DJ.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-dim">
        Soundsible analyses tempo, beat grid, key, energy, musical sections, and
        cue points. It orders a route for musical compatibility, prepares the
        next track on a second deck, and chooses the transition that fits.
      </p>
      <ul class="mt-7 grid gap-3 text-sm text-dim" role="list">
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">◆</span><span><strong class="text-main">Choose a direction.</strong> Steer from tracks, artists, albums, playlists, favourites, or let Auto explore.</span></li>
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">◆</span><span><strong class="text-main">Edit the route.</strong> Place a must-play song, rearrange the set, and rebuild the joins around your choices.</span></li>
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">◆</span><span><strong class="text-main">Hear a real mix.</strong> Beatmatched blends, bass swaps, filters, echo cuts, and safe fades run through a two-deck audio engine.</span></li>
      </ul>
      <a
        href={REPO_URL}
        class="mt-8 inline-flex font-semibold text-secondary underline decoration-secondary/40 underline-offset-4 transition hover:decoration-secondary"
      >
        Explore Soundsible on GitHub →
      </a>
    </div>

    <div data-reveal class="relative" aria-label="Auto Mode set diagram">
      <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-accent/20 via-transparent to-secondary/20 blur-2xl" aria-hidden="true"></div>
      <div class="relative overflow-hidden rounded-3xl border border-[var(--glass-border)] bg-[#101014]/95 p-5 shadow-card sm:p-7">
        <div class="flex items-center justify-between border-b border-[var(--glass-border)] pb-4">
          <div>
            <p class="font-display text-xs font-bold uppercase tracking-[0.18em] text-accent">On air</p>
            <p class="mt-1 font-display text-lg font-semibold text-main">Adaptive set</p>
          </div>
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">AUTO</span>
        </div>

        <div class="mt-6 grid grid-cols-[1fr_auto_1fr] items-center gap-3 sm:gap-5">
          <div class="rounded-2xl border border-[var(--glass-border)] bg-card p-4">
            <p class="text-[0.65rem] font-bold uppercase tracking-widest text-dim">Deck A · live</p>
            <p class="mt-5 font-display font-semibold text-main">Night Drive</p>
            <p class="mt-1 text-xs text-dim">122 BPM · A minor</p>
            <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-surface"><span class="block h-full w-3/4 rounded-full bg-accent"></span></div>
          </div>
          <div class="grid place-items-center gap-2 text-center">
            <span class="text-[0.6rem] font-bold uppercase tracking-wider text-dim">Bass swap</span>
            <span class="grid h-10 w-10 place-items-center rounded-full border border-accent/40 bg-accent/10 font-display text-accent" aria-hidden="true">→</span>
            <span class="text-[0.65rem] text-dim">16 bars</span>
          </div>
          <div class="rounded-2xl border border-secondary/30 bg-card p-4">
            <p class="text-[0.65rem] font-bold uppercase tracking-widest text-secondary">Deck B · cued</p>
            <p class="mt-5 font-display font-semibold text-main">Afterglow</p>
            <p class="mt-1 text-xs text-dim">124 BPM · E minor</p>
            <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-surface"><span class="block h-full w-1/3 rounded-full bg-secondary"></span></div>
          </div>
        </div>

        <div class="mt-6 border-t border-[var(--glass-border)] pt-5">
          <div class="flex items-center justify-between">
            <p class="font-display text-xs font-bold uppercase tracking-[0.18em] text-dim">Editable route</p>
            <p class="text-xs text-dim">Sources: Favourites · Synthwave</p>
          </div>
          <ol class="mt-3 grid gap-2 text-sm" role="list">
            <li class="flex items-center gap-3 rounded-xl bg-surface px-3 py-2.5"><span class="text-accent">01</span><span class="flex-1 text-main">Afterglow</span><span class="text-xs text-dim">Cued</span></li>
            <li class="flex items-center gap-3 rounded-xl bg-surface px-3 py-2.5"><span class="text-dim">02</span><span class="flex-1 text-main">Your must-play track</span><span class="rounded-full bg-secondary/15 px-2 py-0.5 text-[0.65rem] text-secondary">Fixed</span></li>
            <li class="flex items-center gap-3 rounded-xl bg-surface px-3 py-2.5"><span class="text-dim">03</span><span class="flex-1 text-main">Auto-selected bridge</span><span class="text-xs text-dim">Planned</span></li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
