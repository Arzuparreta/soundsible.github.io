---
import Layout from '../layouts/Layout.astro';
import DocsNav from './DocsNav.astro';
import { href, pick, release, type Locale } from '../lib/site';
import entries from '../generated/catalog.json';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, es: string) => pick(locale, en, es);
const shortcuts = [
  {
    title: t('Install Soundsible', 'Instala Soundsible'),
    slugs: ['native-installation', 'docker', 'desktop'],
  },
  {
    title: t('Start listening', 'Empieza a escuchar'),
    slugs: ['music-migration', 'opensubsonic', 'dj-mode', 'live'],
  },
  {
    title: t('Manage your server', 'Administra tu servidor'),
    slugs: ['install', 'configuration', 'troubleshooting'],
  },
];
---

<Layout
  locale={locale}
  page="docs/"
  title={t('Documentation — Soundsible', 'Documentación — Soundsible')}
  description={t(
    'Guides to installing, using, administering and developing Soundsible.',
    'Guías para instalar, usar, administrar y desarrollar Soundsible.',
  )}
>
  <details class="mobile-doc-nav">
    <summary>{t('Browse documentation', 'Explorar documentación')}</summary>
    <nav aria-label={t('Documentation', 'Documentación')}>
      <DocsNav locale={locale} slug="" />
    </nav>
  </details>
  <div class="docs-shell">
    <nav class="docs-sidebar" aria-label={t('Documentation', 'Documentación')}>
      <DocsNav locale={locale} slug="" />
    </nav>
    <main id="main" class="doc-main docs-root">
      <header class="docs-root-heading">
        <h1>{t('Documentation', 'Documentación')}</h1>
        <div class="actions">
          <button class="button" data-search-open>
            {t('Search the documentation', 'Buscar en la documentación')}
            <span aria-hidden="true">⌕</span>
          </button>
          <span class="release-line">{release.tag}</span>
        </div>
      </header>
      {
        shortcuts.map((section) => (
          <section class="docs-shortcuts">
            <h2>{section.title}</h2>
            {section.slugs.map((slug) => {
              const doc = entries.find((entry) => entry.locale === locale && entry.slug === slug);
              return (
                doc && (
                  <a class="doc-index-link" href={href(locale, `docs/${doc.slug}/`)}>
                    <strong>{doc.title}</strong>
                    <p>{doc.description}</p>
                  </a>
                )
              );
            })}
          </section>
        ))
      }
    </main>
  </div>
</Layout>
