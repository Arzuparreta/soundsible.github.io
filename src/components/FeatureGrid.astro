---
const features = [
  {
    title: "YouTube, YouTube Music & Podcasts",
    body: "Search and download from a practically unlimited catalog. iTunes podcasts in the same player. Deezer metadata for charts and discovery.",
  },
  {
    title: "Your Library, Your Rules",
    body: "Album grids, artist pages, playlists, and favourites. Edit metadata and artwork. Organize your music exactly how you want, from any device.",
  },
  {
    title: "Synced Lyrics",
    body: "Follow songs line by line on mobile or desktop while you listen. Lyrics stay in sync with playback automatically.",
  },
  {
    title: "Every Device, One Player",
    body: "A responsive SolidJS web player on desktop, tablet, and phone. Install as a PWA for a native-app feel. Desktop beta app available with no terminal needed.",
  },
  {
    title: "Live Broadcasting",
    body: "Go live from your Station and let anyone listen through the community hub. DJ with transitions, crossfade, and real-time chat. No account needed for listeners.",
  },
  {
    title: "Docker & Native Install",
    body: "Deploy with a single docker compose up. Or run natively on Linux, macOS, or Windows. A guided setup wizard gets you listening in minutes.",
  },
  {
    title: "Flexible Storage Backends",
    body: "Store your library on local disk, a NAS, or S3-compatible object storage — Cloudflare R2, Backblaze B2, or any S3 provider. Your files, your control.",
  },
  {
    title: "Agent & Car Integrations",
    body: "REST API for AI assistants like OpenClaw, Hermes, and local agents. Car media surface integration. Control Soundsible from anywhere.",
  },
  {
    title: "Private & Self-hosted",
    body: "No ads, no tracking, no subscription. Your listening history stays on your machine. Personalized recommendations and endless radio learn from you, not a cloud profile.",
  },
] as const;
---

<section
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  aria-labelledby="features-heading"
>
  <div data-reveal class="max-w-2xl text-center mx-auto">
    <h2
      id="features-heading"
      class="font-display text-3xl font-semibold tracking-tight text-main sm:text-4xl"
    >
      Everything you expect from a modern player — and more
    </h2>
    <p class="mt-4 text-lg text-dim">
      Self-hosted, private, and as polished as the apps you grew up streaming on.
      A full-featured music station with streaming-grade playback, live broadcasting,
      multi-device sync, Docker deployment, and a growing integration ecosystem —
      all free and open source.
    </p>
  </div>

  <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {
      features.map((f, i) => (
        <li data-reveal>
          <article class="group relative h-full overflow-hidden rounded-2xl border border-[var(--glass-border)] bg-card/90 p-6 shadow-card backdrop-blur-md transition hover:border-accent/35">
            <div
              class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-accent/10 opacity-0 blur-2xl transition group-hover:opacity-100"
              aria-hidden="true"
            />
            <div class="relative">
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-surface ring-1 ring-[var(--glass-border)]">
                <span
                  class="flex h-6 w-6 items-center justify-center font-display text-sm font-bold text-accent"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
              </div>
              <h3 class="font-display text-lg font-semibold text-main">
                {f.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-dim">{f.body}</p>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
