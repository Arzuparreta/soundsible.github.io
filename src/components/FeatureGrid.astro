---
const features = [
  {
    title: "Search Beyond Your Library",
    body: "Search your collection, YouTube, MusicBrainz, and Deezer in one ranked view. Preview a match now, then acquire and tag it without leaving the player.",
  },
  {
    title: "Your Library, Your Rules",
    body: "Album grids, artist pages, playlists, and favourites. Edit metadata and artwork. Organize your music exactly how you want, from any device.",
  },
  {
    title: "Local Discovery & Radio",
    body: "Recommendations, Autoplay, and endless Radio learn from listening signals stored on your Station — not from an advertising profile in the cloud.",
  },
  {
    title: "Every Device, One Library",
    body: "Use the responsive web player, PWA, desktop beta, native iOS app, car controls, or an OpenSubsonic client. Accounts, favourites, playlists, and history stay separate.",
  },
  {
    title: "Live Program Broadcasting",
    body: "Broadcast the actual program bus — both decks, Auto transitions, EQ, filters, and effects — to a browser listening room with chat. Listeners need no account.",
  },
  {
    title: "Docker & Native Install",
    body: "Deploy with a single docker compose up. Or run natively on Linux, macOS, or Windows. A guided setup wizard gets you listening in minutes.",
  },
  {
    title: "Flexible Storage Backends",
    body: "Store your library on local disk, a NAS, or S3-compatible object storage — Cloudflare R2, Backblaze B2, or any S3 provider. Your files, your control.",
  },
  {
    title: "Podcasts, Lyrics & Migration",
    body: "Keep podcasts in the same player, follow time-synced lyrics, and bring Spotify or Apple Music playlists into a library you control.",
  },
  {
    title: "Agents & Automations",
    body: "A scoped REST API lets OpenClaw, Hermes, and local assistants search, queue, play, and target a device without handing them unrestricted Station access.",
  },
] as const;
---

<section
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  aria-labelledby="features-heading"
>
  <div data-reveal class="max-w-2xl text-center mx-auto">
    <h2
      id="features-heading"
      class="font-display text-3xl font-semibold tracking-tight text-main sm:text-4xl"
    >
      One player for the entire music journey
    </h2>
    <p class="mt-4 text-lg text-dim">
      Discovery, acquisition, organization, listening, mixing, and broadcasting
      belong together. Soundsible keeps that full loop private, free, and open source.
    </p>
  </div>

  <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {
      features.map((f, i) => (
        <li data-reveal>
          <article class="group relative h-full overflow-hidden rounded-2xl border border-[var(--glass-border)] bg-card/90 p-6 shadow-card backdrop-blur-md transition hover:border-accent/35">
            <div
              class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-accent/10 opacity-0 blur-2xl transition group-hover:opacity-100"
              aria-hidden="true"
            />
            <div class="relative">
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-surface ring-1 ring-[var(--glass-border)]">
                <span
                  class="flex h-6 w-6 items-center justify-center font-display text-sm font-bold text-accent"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
              </div>
              <h3 class="font-display text-lg font-semibold text-main">
                {f.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-dim">{f.body}</p>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
