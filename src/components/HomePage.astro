---
import images from '../generated/images.json';
import Layout from '../layouts/Layout.astro';
import { href, pick, release, type Locale } from '../lib/site';
import { publicAsset } from '../public-asset';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, es: string) => pick(locale, en, es);
// Screenshots arrive with the release snapshot, so a slide only appears once
// every image it needs has been imported and fingerprinted.
const imported: Record<string, string> = images;
const shots = [
  {
    caption: t(
      'Library, artwork and queue in one player.',
      'Biblioteca, portada y cola en un mismo reproductor.',
    ),
    images: [
      {
        file: 'desktop-now-playing.png',
        width: 1912,
        height: 963,
        alt: t(
          'Soundsible player with the library, the current artwork and the playback queue',
          'Reproductor Soundsible con la biblioteca, la portada actual y la cola de reproducción',
        ),
      },
    ],
  },
  {
    caption: t('Every song you own, in one list.', 'Todas tus canciones, en una lista.'),
    images: [
      {
        file: 'desktop-library.png',
        width: 1911,
        height: 966,
        alt: t(
          'Soundsible library listing songs, albums and artists',
          'Biblioteca de Soundsible con canciones, álbumes y artistas',
        ),
      },
    ],
  },
  {
    caption: t('Search once, across every source.', 'Busca una vez, en todas las fuentes.'),
    images: [
      {
        file: 'desktop-search.png',
        width: 1913,
        height: 962,
        alt: t(
          'Soundsible search results with a top artist, songs and albums',
          'Resultados de búsqueda de Soundsible con artista destacado, canciones y álbumes',
        ),
      },
    ],
  },
  {
    caption: t('The same library in your pocket.', 'La misma biblioteca en tu bolsillo.'),
    images: [
      {
        file: 'mobile-library.png',
        width: 1170,
        height: 2532,
        alt: t(
          'Soundsible on a phone, showing the song list and the mini player',
          'Soundsible en un móvil, con la lista de canciones y el mini reproductor',
        ),
      },
      {
        file: 'mobile-now-playing.png',
        width: 1170,
        height: 2532,
        alt: t(
          'Soundsible on a phone, showing the player with synced lyrics',
          'Soundsible en un móvil, con el reproductor y la letra sincronizada',
        ),
      },
    ],
  },
].filter((shot) => shot.images.every((image) => `docs/images/${image.file}` in imported));
const asset = (file: string) => publicAsset(imported[`docs/images/${file}`]);
const paths = [
  [
    '01',
    t('Bring your music', 'Trae tu música'),
    t(
      'Bring your music profile across from Spotify or Apple Music, using your account export.',
      'Trae tu perfil musical de Spotify o Apple Music a partir de la exportación de tu cuenta.',
    ),
    'music-migration',
  ],
  [
    '02',
    t('Make it a DJ set', 'Conviértela en una sesión DJ'),
    t(
      'Choose the sources, shape the route and let DJ Mode handle the transitions.',
      'Elige las fuentes, ajusta el recorrido y deja que el modo DJ se encargue de las transiciones.',
    ),
    'dj-mode',
  ],
  [
    '03',
    t('Listen on your devices', 'Escucha en tus dispositivos'),
    t(
      'Use the web player, desktop app, iOS app or an OpenSubsonic client.',
      'Usa el reproductor web, la aplicación de escritorio, iOS o un cliente OpenSubsonic.',
    ),
    'opensubsonic',
  ],
  [
    '04',
    t('Share a live session', 'Comparte una sesión en directo'),
    t(
      'Broadcast what you hear. Your listeners join from their browser.',
      'Emite lo que escuchas. Tus oyentes se conectan desde el navegador.',
    ),
    'live',
  ],
];
---

<Layout
  locale={locale}
  page=""
  title={t('Soundsible — Music on your own terms', 'Soundsible — Tu música, a tu manera')}
  description={t(
    'Discover, collect and play music on your own server, with a built-in DJ. Installation, documentation and live listening.',
    'Descubre, organiza y escucha música en tu propio servidor, con un DJ integrado. Instalación, documentación y escucha en directo.',
  )}
>
  <main id="main" class="container home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">{t('YOUR MUSIC · YOUR SERVER', 'TU MÚSICA · TU SERVIDOR')}</p><h1
          id="home-title"
        >
          {t('A home for your music.', 'Un hogar para tu música.')}
        </h1><p class="lead">
          {
            t(
              'Discover music, keep it in your library and play it anywhere. Soundsible runs on your own machine, with an automatic DJ built in.',
              'Descubre música, guárdala en tu biblioteca y escúchala donde quieras. Soundsible funciona en tu propio equipo, con un DJ automático integrado.',
            )
          }
        </p><div class="actions">
          <a class="button primary" href={href(locale, 'start/')}
            >{t('Get started', 'Empezar')} <span aria-hidden="true">↗</span></a
          ><a class="button" href={href(locale, 'docs/')}
            >{t('Read the docs', 'Leer la documentación')} <span aria-hidden="true">→</span></a
          >
        </div>
        <aside class="release-note">
          <span class="status-dot" aria-hidden="true"></span><a href={release.url}
            >{release.tag} <span aria-hidden="true">↗</span></a
          ><p>
            {t('Free and open source.', 'Gratuito y de código abierto.')}<br />{' '}{
              t('Hosted by you.', 'Alojado por ti.')
            }
          </p><a class="subtle-link" href={href(locale, 'project/')}
            >{t('About the project', 'Sobre el proyecto')} →</a
          >
        </aside>
      </div>
      <figure
        class="product-figure"
        data-carousel={shots.length > 1 ? '' : undefined}
        role={shots.length > 1 ? 'group' : undefined}
        aria-roledescription={shots.length > 1 ? t('carousel', 'carrusel') : undefined}
        aria-label={shots.length > 1
          ? t('Soundsible screenshots', 'Capturas de Soundsible')
          : undefined}
      >
        <div class="figure-bar">
          <span>{t('THE PLAYER', 'EL REPRODUCTOR')}</span><span
            >{t('Web · Desktop · Mobile', 'Web · Escritorio · Móvil')}</span
          >
        </div>
        <div class="shots">
          {
            shots.map((shot, index) => (
              <a
                class:list={['shot', index === 0 && 'is-current']}
                href={asset(shot.images[0].file)}
                data-shot-caption={shot.caption}
                data-image-preview
                aria-label={t('Enlarge this screenshot', 'Ampliar esta captura')}
              >
                <>
                  <span class:list={['shot-media', shot.images.length > 1 && 'is-pair']}>
                    {shot.images.map((image) => (
                      <img
                        src={asset(image.file)}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : 'auto'}
                      />
                    ))}
                  </span>
                  <span class="image-enlarge" aria-hidden="true">
                    ↗
                  </span>
                </>
              </a>
            ))
          }
        </div>
        <figcaption>
          <span data-shot-label>{shots[0].caption}</span><span class="figure-hint"
            >{t('Click to enlarge', 'Pulsa para ampliar')}</span
          >{
            shots.length > 1 && (
              <div class="shot-controls">
                <>
                  <div class="shot-dots">
                    {shots.map((_, index) => (
                      <button
                        type="button"
                        data-shot-dot={index}
                        aria-current={index === 0 ? 'true' : undefined}
                        aria-label={t(
                          `Show screenshot ${index + 1} of ${shots.length}`,
                          `Mostrar la captura ${index + 1} de ${shots.length}`,
                        )}
                      />
                    ))}
                  </div>
                  <button
                    type="button"
                    class="shot-toggle"
                    data-shot-toggle
                    data-label-play={t('Play the screenshots', 'Reproducir las capturas')}
                    data-label-pause={t('Pause the screenshots', 'Pausar las capturas')}
                    aria-label={t('Pause the screenshots', 'Pausar las capturas')}
                  >
                    <span aria-hidden="true" />
                  </button>
                </>
              </div>
            )
          }
        </figcaption>
      </figure>
    </section>
    <section class="explore-section" aria-labelledby="explore-heading">
      <div class="section-heading">
        <h2 id="explore-heading">{t('Find your way around', 'Encuentra lo que necesitas')}</h2><a
          href={href(locale, 'docs/')}>{t('All documentation', 'Toda la documentación')} →</a
        >
      </div><div class="task-grid">
        {
          paths.map(([number, title, description, doc]) => (
            <a class="task-row" href={href(locale, `docs/${doc}/`)}>
              <>
                <span class="row-number">{number}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{description}</p>
                  </>
                </div>
                <span class="row-arrow" aria-hidden="true">
                  ↗
                </span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="home-bottom">
      <div>
        <h2>{t('Ready to make it yours?', '¿Listo para hacerlo tuyo?')}</h2><p>
          {
            t(
              'Compare installation options and find the right client for your devices.',
              'Compara las opciones de instalación y encuentra el cliente para tus dispositivos.',
            )
          }
        </p>
      </div><a class="text-action" href={href(locale, 'start/')}
        >{t('Install Soundsible', 'Instalar Soundsible')} →</a
      >
    </section>
  </main>
  <dialog id="image-dialog" aria-label={t('Screenshot', 'Captura')}>
    <button type="button" data-close-dialog>{t('Close', 'Cerrar')} ✕</button><img
      src={asset(shots[0].images[0].file)}
      alt={shots[0].images[0].alt}
      width={shots[0].images[0].width}
      height={shots[0].images[0].height}
    />
  </dialog>
</Layout>
