---
import { existsSync, readFileSync } from 'node:fs';
import images from '../generated/images.json';
import Layout from '../layouts/Layout.astro';
import { href, pick, release, repoUrl, type Locale } from '../lib/site';
import { themes, type Theme } from '../lib/themes';
import { publicAsset } from '../public-asset';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, es: string) => pick(locale, en, es);
// Screenshots arrive with the release snapshot, so a slide only appears once
// every image it needs has been imported and fingerprinted. Each screen comes
// once per player theme (`docs/images/screenshots/<theme>/<name>.webp`) and the
// page shows the one taken in the theme it is wearing. A release from before
// that layout has a single `docs/images/<name>.png`, shown in every theme.
// Every capture is lazy, the first slide's too: a lazy image the page hides is
// never fetched, so only the theme on show is downloaded.
const demoReady = existsSync('public/demo/player.html');
const demoSleeves = demoReady
  ? [
      ...new Map(
        (
          JSON.parse(readFileSync('public/demo/catalog.json', 'utf8')) as Array<{
            album_id: string;
            album: string;
            artist: string;
          }>
        ).map((track) => [track.album_id, track]),
      ).values(),
    ]
      .slice(0, 2)
      .map((album) => ({
        ...album,
        art: `data:image/svg+xml;base64,${readFileSync(`public/demo/media/${album.album_id}.svg`, 'base64')}`,
      }))
  : [];
const imported: Record<string, string> = images;
const screenshot = (name: string) => {
  const single = imported[`docs/images/${name}.png`];
  const sources = themes.map(
    ({ id }) => [id, imported[`docs/images/screenshots/${id}/${name}.webp`] ?? single] as const,
  );
  if (!sources.every(([, source]) => source)) return null;
  return Object.fromEntries(sources.map(([id, source]) => [id, publicAsset(source)])) as Record<
    Theme,
    string
  >;
};
const desktop = { width: 1920, height: 1080 };
const phone = { width: 1170, height: 2532 };
const shots = [
  [
    {
      name: 'desktop-now-playing',
      ...desktop,
      alt: t(
        'Soundsible library with the player docked on the right',
        'Biblioteca de Soundsible con el reproductor acoplado a la derecha',
      ),
    },
  ],
  [
    {
      name: 'desktop-search',
      ...desktop,
      alt: t(
        'Soundsible search results with a top artist, songs and albums',
        'Resultados de búsqueda de Soundsible con artista destacado, canciones y álbumes',
      ),
    },
  ],
  [
    {
      name: 'mobile-library',
      ...phone,
      alt: t(
        'Soundsible on a phone, showing the song list and the mini player',
        'Soundsible en un móvil, con la lista de canciones y el mini reproductor',
      ),
    },
  ],
  [
    {
      name: 'mobile-now-playing',
      ...phone,
      alt: t(
        'Soundsible on a phone, showing the player with synced lyrics',
        'Soundsible en un móvil, con el reproductor y la letra sincronizada',
      ),
    },
  ],
].flatMap((screens) => {
  const images = screens.flatMap((screen) => {
    const src = screenshot(screen.name);
    return src ? [{ ...screen, src }] : [];
  });
  return images.length === screens.length ? [{ images }] : [];
});
---

<Layout
  locale={locale}
  page=""
  title={t('Soundsible — Music on your own terms', 'Soundsible — Tu música, a tu manera')}
  description={t(
    'Discover, collect and play music on your own server, with a built-in DJ. Installation, documentation and live listening.',
    'Descubre, organiza y escucha música en tu propio servidor, con un DJ integrado. Instalación, documentación y escucha en directo.',
  )}
>
  <main id="main" class="container home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <a
          class="github-button"
          href={repoUrl}
          aria-label={t('Soundsible on GitHub', 'Soundsible en GitHub')}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
            viewBox="0 0 16 16"
            ><path
              d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"
            ></path></svg
          ><span>GitHub</span><span aria-hidden="true">↗</span>
        </a><h1 id="home-title">
          {
            t(
              'Host your free, personal music service',
              'Aloja tu propio servicio de música gratuito',
            )
          }
        </h1><p class="lead">
          {
            t(
              'Run Soundsible in your server and listen to any music from any device',
              'Instala Soundsible en tu server y escucha cualquier música desde cualquier dispositivo',
            )
          }
        </p><div class="actions">
          <a class="button primary" href={href(locale, 'start/')}
            >{t('Get started', 'Empezar')} <span aria-hidden="true">↗</span></a
          ><a class="button" href={href(locale, 'docs/')}
            >{t('Read the docs', 'Leer la documentación')} <span aria-hidden="true">→</span></a
          >
        </div>
        <aside class="release-note">
          <a href={release.url}
            ><span class="status-dot" aria-hidden="true"></span>{release.tag}
            <span aria-hidden="true">↗</span></a
          ><a class="subtle-link" href={href(locale, 'project/')}
            >{t('About the project', 'Sobre el proyecto')} →</a
          >
        </aside>
      </div>
      {
        demoReady ? (
          <section class="live-demo" aria-label={t('Playable demo', 'Demo interactiva')}>
            <div class="demo-toolbar">
              <p>
                {t('Play music from an open collection', 'Escucha música de una colección abierta')}
              </p>
              <div class="demo-links">
                <a href={publicAsset(`demo/index.html?lang=${locale}`)}>
                  {t('Open full-page player', 'Abrir reproductor a pantalla completa')} ↗
                </a>
                <a href={publicAsset('demo/credits.html')}>
                  {t('Music credits', 'Créditos musicales')}
                </a>
                <button type="button" hidden data-close-demo>
                  {t('Close player', 'Cerrar reproductor')}
                </button>
              </div>
            </div>
            <button
              type="button"
              data-launch-demo
              aria-controls="demo-player"
              aria-expanded="false"
            >
              <span class="demo-sleeves" aria-hidden="true">
                {demoSleeves.map((album) => (
                  <span class="demo-album">
                    <img src={album.art} width="400" height="400" alt="" />
                    <strong>{album.album}</strong>
                    <small>{album.artist}</small>
                  </span>
                ))}
              </span>
              <span class="demo-cta">{t('Try Soundsible', 'Probar Soundsible')} ▸</span>
            </button>
            <iframe
              id="demo-player"
              hidden
              data-demo-src={publicAsset(`demo/index.html?lang=${locale}`)}
              title={t('Soundsible player', 'Reproductor de Soundsible')}
            />
          </section>
        ) : (
          <div
            class="shot-stage"
            data-carousel={shots.length > 1 ? '' : undefined}
            role={shots.length > 1 ? 'group' : undefined}
            aria-roledescription={shots.length > 1 ? t('carousel', 'carrusel') : undefined}
            aria-label={
              shots.length > 1 ? t('Soundsible screenshots', 'Capturas de Soundsible') : undefined
            }
          >
            {shots.length > 1 && (
              <button
                type="button"
                class="shot-arrow prev"
                data-shot-step="-1"
                aria-label={t('Previous screenshot', 'Captura anterior')}
              >
                <span aria-hidden="true" />
              </button>
            )}
            <figure class="product-figure">
              <div class="shots">
                {shots.map((shot, index) => (
                  <a
                    class:list={['shot', index === 0 && 'is-current']}
                    href={shot.images[0].src.dark}
                    data-shot-index={index}
                    data-portrait={shot.images[0].height > shot.images[0].width ? '' : undefined}
                    data-image-preview
                    aria-label={t('Enlarge this screenshot', 'Ampliar esta captura')}
                  >
                    <>
                      <span class="shot-media">
                        {shot.images.map((image) =>
                          themes.map(({ id }) => (
                            <img
                              class={`theme-${id}`}
                              src={image.src[id]}
                              alt={image.alt}
                              width={image.width}
                              height={image.height}
                              loading="lazy"
                              fetchpriority={index === 0 ? 'high' : 'auto'}
                            />
                          )),
                        )}
                      </span>
                      <span class="image-enlarge" aria-hidden="true">
                        ↗
                      </span>
                    </>
                  </a>
                ))}
              </div>
            </figure>
            {shots.length > 1 && (
              <button
                type="button"
                class="shot-arrow next"
                data-shot-step="1"
                aria-label={t('Next screenshot', 'Captura siguiente')}
              >
                <span aria-hidden="true" />
              </button>
            )}
          </div>
        )
      }
    </section>
    <section class="home-bottom">
      <div>
        <h2>{t('Ready to make it yours?', '¿Listo para hacerlo tuyo?')}</h2><p>
          {
            t(
              'Compare installation options and find the right client for your devices.',
              'Compara las opciones de instalación y encuentra el cliente para tus dispositivos.',
            )
          }
        </p>
      </div><a class="text-action" href={href(locale, 'start/')}
        >{t('Install Soundsible', 'Instalar Soundsible')} →</a
      >
    </section>
  </main>
  {
    !demoReady && shots[0] && (
      <dialog id="image-dialog" aria-label={t('Screenshot', 'Captura')}>
        <>
          <button type="button" data-close-dialog>
            {t('Close', 'Cerrar')} ✕
          </button>
          <img
            src={shots[0].images[0].src.dark}
            alt={shots[0].images[0].alt}
            width={shots[0].images[0].width}
            height={shots[0].images[0].height}
            loading="lazy"
          />
        </>
      </dialog>
    )
  }
</Layout>

<script>
  const launch = document.querySelector<HTMLButtonElement>('[data-launch-demo]');
  const close = document.querySelector<HTMLButtonElement>('[data-close-demo]');
  const frame = document.querySelector<HTMLIFrameElement>('#demo-player');
  if (launch && close && frame) {
    launch.addEventListener('click', () => {
      frame.src = frame.dataset.demoSrc!;
      frame.hidden = false;
      close.hidden = false;
      launch.hidden = true;
      launch.setAttribute('aria-expanded', 'true');
      frame.focus();
    });
    close.addEventListener('click', () => {
      frame.hidden = true;
      frame.removeAttribute('src');
      close.hidden = true;
      launch.hidden = false;
      launch.setAttribute('aria-expanded', 'false');
      launch.focus();
    });
  }
</script>
<style>
  .live-demo {
    width: 100%;
    min-width: 0;
  }
  .demo-toolbar,
  .demo-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
  }
  .demo-toolbar {
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .demo-toolbar p {
    margin: 0;
    font-weight: 650;
  }
  .demo-links {
    font-size: 0.875rem;
  }
  .demo-links a,
  .demo-links button {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .demo-links button {
    cursor: pointer;
  }
  [data-launch-demo] {
    display: grid;
    width: 100%;
    justify-items: center;
    gap: 1.5rem;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: #181a1c;
    color: #f5f5f2;
    cursor: pointer;
    border-radius: 0.75rem;
  }
  .demo-sleeves {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 14rem));
    gap: clamp(1rem, 4vw, 2rem);
  }
  .demo-album {
    display: grid;
    gap: 0.2rem;
    text-align: left;
  }
  .demo-album img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .demo-album small {
    color: #c6cbc6;
  }
  .demo-cta {
    border-radius: 2rem;
    background: #eff6eb;
    color: #171c18;
    padding: 0.7rem 1.2rem;
    font-weight: 700;
  }
  [data-launch-demo]:hover .demo-cta {
    background: #d4e8cd;
  }
  .live-demo iframe {
    width: 100%;
    height: clamp(28rem, 76svh, 56rem);
    border: 0;
    border-radius: 0.75rem;
    background: #101014;
  }
  .live-demo [hidden] {
    display: none;
  }
</style>
