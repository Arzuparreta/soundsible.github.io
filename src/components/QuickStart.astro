---
import { README_INSTALL_URL } from "../constants";

const nativeSteps = String.raw`git clone https://github.com/Arzuparreta/soundsible.git
cd soundsible

# Install web player deps (one-time)
cd ui_web && npm ci && cd ..

# Run it — setup wizard opens on first launch
python3 run.py`;

const dockerSteps = String.raw`curl -O https://raw.githubusercontent.com/Arzuparreta/soundsible/main/compose.yaml
docker compose up -d
docker compose ps`;
---

<section
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  aria-labelledby="quickstart-heading"
>
  <div data-reveal class="max-w-2xl text-center mx-auto">
    <h2
      id="quickstart-heading"
      class="font-display text-3xl font-semibold tracking-tight text-main sm:text-4xl"
    >
      Up and listening in minutes
    </h2>
    <p class="mt-4 text-lg text-dim">
      Run <strong class="font-medium text-main">natively</strong> on Linux,
      macOS, or Windows, or use <strong class="font-medium text-main">Docker</strong>
      for a containerized deployment.
    </p>
  </div>

  <div class="mt-14 grid min-w-0 gap-8 lg:grid-cols-2">
    <!-- Native (Recommended) -->
    <div data-reveal class="relative min-w-0">
      <div class="mb-4 flex items-center gap-3">
        <span
          class="rounded-lg bg-accent/15 px-3 py-1 font-display text-xs font-bold uppercase tracking-wider text-accent"
        >
          Recommended
        </span>
        <h3 class="font-display text-xl font-semibold text-main">
          Linux / macOS / Windows
        </h3>
      </div>
      <p class="mb-4 text-sm text-dim">
        Needs <strong class="font-medium text-main">Python 3.10+</strong>,
        <strong class="font-medium text-main">FFmpeg</strong>,
        <strong class="font-medium text-main">Node.js 22+</strong>, and
        <strong class="font-medium text-main">git</strong>.
      </p>
      <div
        class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-accent/20 via-transparent to-secondary/15 opacity-70 blur-xl"
        aria-hidden="true"
      ></div>
      <div
        class="relative min-w-0 overflow-hidden rounded-2xl border border-[var(--glass-border)] bg-[#0d0d0f] shadow-card"
      >
        <div
          class="flex items-center gap-2 border-b border-[var(--glass-border)] px-4 py-3"
        >
          <span
            class="h-3 w-3 rounded-full bg-[#ff5f57]"
            aria-hidden="true"
          ></span>
          <span
            class="h-3 w-3 rounded-full bg-[#febc2e]"
            aria-hidden="true"
          ></span>
          <span
            class="h-3 w-3 rounded-full bg-[#28c840]"
            aria-hidden="true"
          ></span>
          <span class="ml-3 text-xs text-dim">terminal</span>
        </div>
        <pre
          class="min-w-0 overflow-x-auto p-4 font-mono text-[0.8rem] leading-relaxed text-main sm:text-sm"
          tabindex="0"
        ><code>{nativeSteps}</code></pre>
        <div
          class="border-t border-[var(--glass-border)] bg-card/50 px-4 py-3 text-sm text-dim"
        >
          First run opens the
          <strong class="text-main">setup wizard</strong> at
          <span class="font-medium text-accent"
            >http://localhost:5099/setup</span
          >. Then open
          <span class="font-medium text-accent"
            >http://localhost:5005/player/</span
          >.
        </div>
      </div>
    </div>

    <!-- Docker -->
    <div data-reveal class="relative min-w-0">
      <div class="mb-4">
        <h3 class="font-display text-xl font-semibold text-main">Docker</h3>
      </div>
      <p class="mb-4 text-sm text-dim">
        Needs only <strong class="font-medium text-main">Docker</strong> and
        <strong class="font-medium text-main">curl</strong>. Published images
        are ready for AMD64 and ARM64.
      </p>
      <div
        class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-secondary/20 via-transparent to-accent/15 opacity-70 blur-xl"
        aria-hidden="true"
      ></div>
      <div
        class="relative min-w-0 overflow-hidden rounded-2xl border border-[var(--glass-border)] bg-[#0d0d0f] shadow-card"
      >
        <div
          class="flex items-center gap-2 border-b border-[var(--glass-border)] px-4 py-3"
        >
          <span
            class="h-3 w-3 rounded-full bg-[#ff5f57]"
            aria-hidden="true"
          ></span>
          <span
            class="h-3 w-3 rounded-full bg-[#febc2e]"
            aria-hidden="true"
          ></span>
          <span
            class="h-3 w-3 rounded-full bg-[#28c840]"
            aria-hidden="true"
          ></span>
          <span class="ml-3 text-xs text-dim">terminal</span>
        </div>
        <pre
          class="min-w-0 overflow-x-auto p-4 font-mono text-[0.8rem] leading-relaxed text-main sm:text-sm"
          tabindex="0"
        ><code>{dockerSteps}</code></pre>
        <div
          class="border-t border-[var(--glass-border)] bg-card/50 px-4 py-3 text-sm text-dim"
        >
          Wait for <code class="rounded bg-card px-1.5 py-0.5 text-xs text-main"
            >healthy</code
          >, then open
          <span class="font-medium text-accent"
            >http://localhost:5005/player/</span
          >
        </div>
      </div>
    </div>
  </div>

  <p class="mt-10 text-center">
    <a
      href={README_INSTALL_URL}
      class="font-semibold text-secondary underline decoration-secondary/40 underline-offset-4 transition hover:decoration-secondary"
    >
      Full installation guide: Docker volumes, Tailscale, headless, storage
      backends, desktop beta →
    </a>
  </p>
</section>
