---
import { publicAsset } from "../public-asset";

const desktop = {
  src: publicAsset("/screenshots/desktop-now-playing.png"),
  alt: "Soundsible app interface",
};
const mobile = [
  {
    src: publicAsset("/screenshots/mobile-now-playing.png"),
    alt: "Soundsible app interface",
  },
  {
    src: publicAsset("/screenshots/mobile-now-playing-library.png"),
    alt: "Soundsible app interface",
  },
  {
    src: publicAsset("/screenshots/mobile-now-playing-lyrics.png"),
    alt: "Soundsible app interface",
  },
] as const;
---

<section
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  aria-labelledby="showcase-heading"
>
  <div data-reveal class="text-center">
    <h2
      id="showcase-heading"
      class="font-display text-3xl font-semibold tracking-tight text-main sm:text-4xl"
    >
      Screenshots
    </h2>
  </div>

  <div
    data-reveal
    class="mx-auto mt-10 grid max-w-5xl gap-2.5 sm:gap-3"
    role="group"
    aria-label="Soundsible app screenshots"
  >
    <div class="overflow-hidden rounded-xl border border-[var(--glass-border)] bg-card/60 shadow-card backdrop-blur-sm sm:rounded-2xl">
      <img
        src={desktop.src}
        alt={desktop.alt}
        width="1906"
        height="944"
        class="block h-auto w-full"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div
      class="grid grid-cols-3 items-start gap-2.5 sm:gap-3"
    >
      {
        mobile.map((shot) => (
          <div class="min-w-0 overflow-hidden rounded-xl border border-[var(--glass-border)] bg-card/60 shadow-card backdrop-blur-sm sm:rounded-2xl">
            <img
              src={shot.src}
              alt={shot.alt}
              width="1170"
              height="2532"
              class="block h-auto w-full"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
