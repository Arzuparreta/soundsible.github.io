---
import { publicAsset } from "../public-asset";

const desktop = {
  src: publicAsset("/screenshots/now-playing-desktop.png"),
  alt: "Soundsible desktop Now Playing with synced lyrics and the upcoming queue",
  caption: "Now Playing — desktop",
};
const mobile = [
  {
    src: publicAsset("/screenshots/mobile-library.PNG"),
    alt: "Soundsible music library on mobile",
    caption: "Library",
  },
  {
    src: publicAsset("/screenshots/mobile-now-playing-lyrics.PNG"),
    alt: "Soundsible mobile Now Playing with synced lyrics",
    caption: "Now Playing · synced lyrics",
  },
] as const;
---

<section
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8"
  aria-labelledby="showcase-heading"
>
  <div data-reveal class="text-center">
    <h2
      id="showcase-heading"
      class="font-display text-3xl font-semibold tracking-tight text-main sm:text-4xl"
    >
      Built for daily listening
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-dim">
      The same interface scales from your desk to your phone: add tracks from YouTube and YouTube Music on their own screens, then browse and search your library separately—in dark-first layouts built for big collections.
    </p>
  </div>

  <div
    data-reveal
    class="mt-14 grid gap-5 lg:grid-cols-[minmax(0,1.9fr)_minmax(18rem,1fr)] lg:items-start"
    role="group"
    aria-label="Soundsible app screenshots"
  >
    <figure class="overflow-hidden rounded-2xl border border-[var(--glass-border)] bg-card/60 shadow-card backdrop-blur-sm">
      <img
        src={desktop.src}
        alt={desktop.alt}
        width="1906"
        height="944"
        class="h-auto w-full object-cover object-top"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="min-w-0 truncate border-t border-[var(--glass-border)] px-4 py-3 text-center text-sm text-dim">
        {desktop.caption}
      </figcaption>
    </figure>
    <div
      class="mx-auto grid w-full max-w-2xl grid-cols-2 items-start gap-3 sm:gap-5 lg:max-w-none"
    >
      {
        mobile.map((shot) => (
          <figure class="min-w-0 overflow-hidden rounded-2xl border border-[var(--glass-border)] bg-card/60 shadow-card backdrop-blur-sm">
            <img
              src={shot.src}
              alt={shot.alt}
              width="1170"
              height="2532"
              class="h-auto w-full object-cover object-top"
              loading="lazy"
              decoding="async"
            />
            <figcaption
              class="min-w-0 truncate border-t border-[var(--glass-border)] px-4 py-3 text-center text-sm text-dim"
            >
              {shot.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
