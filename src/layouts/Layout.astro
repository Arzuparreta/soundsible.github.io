---
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/global.css';
import images from '../generated/images.json';
import { publicAsset } from '../public-asset';
import { href, pick, release, repoUrl, type Locale } from '../lib/site';
import Words from '../components/Words.astro';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  page?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, locale = 'en', page = '', noindex = false } = Astro.props;
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(href(locale, page));
// The social card is generated with the screenshots and arrives with them in
// the release snapshot. A release from before it falls back to the card kept
// here.
const card = (images as Record<string, string>)['docs/images/social-card.png'];
const ogImage = Astro.props.ogImage ?? absolute(publicAsset(card ?? 'og-image.png'));
const nav = [
  ['start/', 'Get started', 'Empezar'],
  ['docs/', 'Documentation', 'Documentación'],
  ['live/', 'Live', 'Live'],
  ['project/', 'Project', 'Proyecto'],
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f5" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={absolute(href('en', page))} />
    <link rel="alternate" hreflang="es" href={absolute(href('es', page))} />
    <link rel="alternate" hreflang="x-default" href={absolute(href('en', page))} />
    <link rel="icon" type="image/png" href={publicAsset('favicon.png')} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={ogImage}
    />
    <title>{title}</title>
    <script is:inline define:vars={{ palettes: ['light', 'dark'] }}>
      let choice = 'system';
      try {
        choice = localStorage.getItem('soundsible:site-theme') || 'system';
      } catch {}
      document.documentElement.dataset.theme = palettes.includes(choice)
        ? choice
        : matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    </script>
  </head>
  <body data-base={publicAsset('')} data-page={page}>
    <a class="skip-link" href="#main"
      ><Words locale={locale} en="Skip to content" es="Saltar al contenido" /></a
    >
    <header class="site-header">
      <div class="header-inner">
        <a class="site-brand" href={href(locale)} data-site-path="" aria-label="Soundsible"
          ><img src={publicAsset('logo-app.png')} width="30" height="30" alt="" /><span
            >soundsible</span
          ></a
        >
        <nav
          class="desktop-nav"
          aria-label={pick(locale, 'Main navigation', 'Navegación principal')}
        >
          {
            nav.map(([path, en, es]) => (
              <a
                href={href(locale, path)}
                data-site-path={path}
                aria-current={page.startsWith(path) ? 'page' : undefined}
              >
                <Words locale={locale} en={en} es={es} />
              </a>
            ))
          }
        </nav>
        <div class="header-tools">
          <button
            class="search-trigger"
            type="button"
            data-search-open
            aria-label={pick(locale, 'Search documentation', 'Buscar documentación')}
            ><svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              ><circle cx="10" cy="10" r="6.5"></circle><path d="m15 15 5 5"></path></svg
            ><span class="search-label"><Words locale={locale} en="Search" es="Buscar" /></span><kbd
              >⌘ K</kbd
            ></button
          >
          <a
            class="language-switch"
            href={href(locale === 'en' ? 'es' : 'en', page)}
            data-language-switch
            hreflang={locale === 'en' ? 'es' : 'en'}
            lang={locale === 'en' ? 'es' : 'en'}
            aria-label={pick(locale, 'Leer en español', 'Read in English')}
            >{locale === 'en' ? 'ES' : 'EN'}</a
          >
          <button
            type="button"
            id="theme-toggle"
            class="theme-control"
            data-mode="system"
            aria-label={pick(
              locale,
              'Theme: System. Switch to light',
              'Tema: Sistema. Cambiar a claro',
            )}
          >
            <svg
              data-theme-icon="light"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
              ></path>
            </svg>
            <svg
              data-theme-icon="dark"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
            </svg>
            <svg
              data-theme-icon="system"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="5"></circle><path
                d="M12 7a5 5 0 0 1 0 10Z"
                fill="currentColor"
                stroke="none"></path><path
                d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
              ></path>
            </svg>
          </button>
          <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav"
            ><Words locale={locale} en="Menu" es="Menú" /></button
          >
        </div>
      </div>
      <nav
        id="mobile-nav"
        hidden
        aria-label={pick(locale, 'Mobile navigation', 'Navegación móvil')}
      >
        {
          nav.map(([path, en, es]) => (
            <a
              href={href(locale, path)}
              data-site-path={path}
              aria-current={page.startsWith(path) ? 'page' : undefined}
            >
              <Words locale={locale} en={en} es={es} />
            </a>
          ))
        }
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <nav aria-label={pick(locale, 'Footer', 'Pie de página')}>
        <a href={release.url}>{release.tag}</a><a
          href={href(locale, 'docs/legal/')}
          data-site-path="docs/legal/"
          ><Words locale={locale} en="Acceptable use" es="Uso aceptable" /></a
        ><a href={href(locale, 'docs/privacy/')} data-site-path="docs/privacy/"
          ><Words locale={locale} en="Privacy" es="Privacidad" /></a
        ><a href={repoUrl}>GitHub ↗</a>
      </nav>
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="dialog-heading">
        <h2 id="search-title">
          <Words locale={locale} en="Search documentation" es="Buscar documentación" />
        </h2><button type="button" data-close-dialog
          ><Words locale={locale} en="Close" es="Cerrar" /></button
        >
      </div>
      <div id="search" data-pagefind-base={publicAsset('pagefind/')} data-status="idle"></div>
      <p id="search-error" hidden>
        <Words
          locale={locale}
          en="Search could not load. Browse the documentation instead."
          es="No se pudo cargar la búsqueda. Puedes consultar el índice de documentación."
        /><a href={href(locale, 'docs/')} data-site-path="docs/"> →</a>
      </p>
      <noscript
        ><a href={href(locale, 'docs/')}
          >{pick(locale, 'Browse documentation', 'Consultar documentación')}</a
        ></noscript
      >
    </dialog>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
