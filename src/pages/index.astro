---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import QuickStart from "../components/QuickStart.astro";
import Showcase from "../components/Showcase.astro";
import LegalTeaser from "../components/LegalTeaser.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Soundsible — Self-hosted music, streaming-grade experience";
const description =
  "Self-hosted music Station: search YouTube & YouTube Music, save tracks, broadcast live DJ sets, sync playback across devices, and enjoy synced lyrics. Docker or native. Free, private, open source (MIT).";
---

<Layout title={title} description={description}>
  <Hero />
  <FeatureGrid />
  <QuickStart />
  <Showcase />
  <LegalTeaser />
  <SiteFooter />
</Layout>
