---
import Layout from "../layouts/Layout.astro";
import { publicAsset } from "../public-asset";

const communityUrl =
  import.meta.env.PUBLIC_COMMUNITY_URL ??
  "https://live.84-247-161-82.sslip.io";
---

<Layout
  title="Soundsible Live — community DJ sessions"
  description="Listen to live DJ sessions broadcast from Soundsible."
>
  <main id="live-app" class="live-shell" data-community-url={communityUrl}>
    <header class="live-header">
      <a href={publicAsset("")} class="brand">
        <img src={publicAsset("logo-app.png")} width="42" height="42" alt="" />
        <span>Soundsible</span>
      </a>
      <span class="live-mark"><i></i> Live</span>
    </header>

    <section id="directory-view" class="directory">
      <div class="intro">
        <span>Soundsible Community</span>
        <h1>Someone is always shaping the next moment.</h1>
        <p>Live DJ sessions, broadcast directly from the Soundsible master.</p>
      </div>
      <div class="directory-head">
        <h2>Live now</h2>
        <button id="refresh-sessions" type="button">Refresh</button>
      </div>
      <p id="directory-error" class="notice" hidden>
        The live service is unavailable. Try again in a moment.
      </p>
      <div id="session-grid" class="session-grid" aria-live="polite"></div>
      <p id="empty-sessions" class="empty" hidden>No sessions are live right now.</p>
    </section>

    <section id="room-view" class="room" hidden>
      <div class="stage">
        <div class="stage-top">
          <button id="leave-room" type="button">← Live</button>
          <span id="room-host"></span>
          <button id="share-room" type="button">Share</button>
        </div>
        <div id="room-art" class="art"><span>♪</span></div>
        <div class="track">
          <span id="room-status">Waiting</span>
          <h1 id="room-title"></h1>
          <p id="room-artist">About to start</p>
        </div>
        <div id="transition" class="transition" hidden>
          <small id="transition-technique"></small>
          <div><span id="transition-progress"></span></div>
          <strong id="secondary-title"></strong>
        </div>
        <audio id="live-audio" autoplay></audio>
        <button id="listen-live" class="listen" type="button">Listen live</button>
        <p id="listen-error" class="listen-error" hidden>
          The live audio could not be connected.
        </p>
      </div>

      <aside class="chat">
        <header>
          <div><small>Live room</small><strong id="chat-title"></strong></div>
          <span id="listener-count">0 listeners</span>
        </header>
        <div id="chat-messages" class="messages" aria-live="polite">
          <p id="chat-empty">Messages appear here from the moment you join.</p>
        </div>
        <form id="chat-form">
          <input id="chat-input" maxlength="500" placeholder="Write a message" aria-label="Write a message" />
          <button type="submit">Send</button>
        </form>
      </aside>
    </section>
  </main>

  <script>
    import "../scripts/live.ts";
  </script>
</Layout>

<style>
  .live-shell {
    min-height: 100vh;
    color: var(--color-main);
  }

  .live-shell [hidden] {
    display: none !important;
  }

  .live-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 24px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    font-family: "Outfit Variable", sans-serif;
    font-size: 1.25rem;
    font-weight: 650;
    text-decoration: none;
  }

  .brand img {
    border-radius: 12px;
  }

  .live-mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    color: #ffb47d;
    background: rgba(249, 122, 18, .1);
    border: 1px solid rgba(249, 122, 18, .24);
    border-radius: 999px;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .live-mark i {
    width: 7px;
    height: 7px;
    background: #ff453a;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(255, 69, 58, .12);
  }

  .directory {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 54px 0 80px;
  }

  .intro {
    max-width: 760px;
    margin-bottom: 68px;
  }

  .intro > span {
    color: #ff9a4a;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .intro h1 {
    margin: 14px 0 18px;
    font-family: "Outfit Variable", sans-serif;
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    font-weight: 610;
    line-height: .98;
    letter-spacing: -.045em;
    text-wrap: balance;
  }

  .intro p {
    margin: 0;
    color: var(--color-dim);
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .directory-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .directory-head h2 {
    margin: 0;
    font-family: "Outfit Variable", sans-serif;
    font-size: 1.45rem;
  }

  .stage-top > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-head button,
  .stage-top button {
    min-height: 42px;
    padding: 0 16px;
    color: var(--color-dim);
    background: rgba(28, 28, 32, .8);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font: inherit;
  }

  .session-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }

  :global(.live-card) {
    display: grid;
    gap: 16px;
    min-width: 0;
    padding: 18px;
    color: inherit;
    text-align: left;
    background: linear-gradient(145deg, rgba(28, 28, 32, .92), rgba(16, 16, 19, .9));
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    box-shadow: 0 18px 46px rgba(0, 0, 0, .22);
    transition: border-color .2s ease, transform .2s ease;
  }

  :global(.live-card:hover) {
    border-color: rgba(249, 122, 18, .35);
    transform: translateY(-2px);
  }

  :global(.live-card-head) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  :global(.live-avatar),
  :global(.live-cover) {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    overflow: hidden;
    background: var(--color-accent);
    border-radius: 14px;
    font-weight: 750;
  }

  :global(.live-avatar) {
    color: #1a0e02;
  }

  :global(.live-cover img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.live-card-copy),
  :global(.live-track-copy) {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  :global(.live-card-copy strong),
  :global(.live-card-copy small),
  :global(.live-track-copy strong),
  :global(.live-track-copy small) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.live-card-copy small),
  :global(.live-track-copy small),
  :global(.live-card footer),
  :global(.live-waiting) {
    color: var(--color-dim);
    font-size: .78rem;
  }

  :global(.live-state) {
    padding: 5px 8px;
    color: #70db93;
    background: rgba(52, 199, 89, .09);
    border-radius: 999px;
    font-size: .67rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  :global(.live-state[data-status="waiting"]),
  :global(.live-state[data-status="paused"]) {
    color: #ffb44c;
    background: rgba(224, 167, 43, .09);
  }

  :global(.live-state[data-status="reconnecting"]) {
    color: #ffb44c;
  }

  :global(.live-track) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  :global(.live-progress) {
    height: 3px;
    overflow: hidden;
    background: rgba(255, 255, 255, .08);
    border-radius: 999px;
  }

  :global(.live-progress span) {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  .notice,
  .empty {
    padding: 46px 20px;
    color: var(--color-dim);
    text-align: center;
    background: rgba(28, 28, 32, .62);
    border: 1px dashed var(--glass-border);
    border-radius: 24px;
  }

  .room {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(310px, .55fr);
    min-height: calc(100vh - 90px);
    background: #09090b;
    border-top: 1px solid var(--glass-border);
  }

  .stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    flex-direction: column;
    padding: 78px 32px 42px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 32%, rgba(249, 122, 18, .16), transparent 38%),
      radial-gradient(circle at 8% 80%, rgba(49, 120, 198, .1), transparent 34%),
      #0b0b0d;
  }

  .stage-top {
    position: absolute;
    top: 18px;
    left: 22px;
    right: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-dim);
  }

  .art {
    display: grid;
    place-items: center;
    width: min(48vh, 56vw, 460px);
    aspect-ratio: 1;
    overflow: hidden;
    color: var(--color-accent);
    background: #17171a;
    border: 1px solid rgba(255, 255, 255, .09);
    border-radius: clamp(28px, 4vw, 52px);
    box-shadow: 0 30px 90px rgba(0, 0, 0, .5);
    font-size: 5rem;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track {
    max-width: 720px;
    margin-top: 26px;
    text-align: center;
  }

  .track > span {
    color: #ff9a4a;
    font-size: .7rem;
    font-weight: 750;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .track h1 {
    margin: 8px 0 4px;
    font-family: "Outfit Variable", sans-serif;
    font-size: clamp(2rem, 4.5vw, 4.2rem);
    font-weight: 620;
    line-height: 1.05;
    letter-spacing: -.035em;
  }

  .track p {
    margin: 0;
    color: var(--color-dim);
    font-size: 1.05rem;
  }

  .transition {
    display: grid;
    width: min(460px, 82%);
    gap: 6px;
    margin-top: 20px;
    color: var(--color-dim);
    text-align: center;
  }

  .transition > div {
    height: 3px;
    overflow: hidden;
    background: rgba(255, 255, 255, .08);
    border-radius: 999px;
  }

  .transition > div span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  .listen {
    min-height: 48px;
    margin-top: 24px;
    padding: 0 26px;
    color: white;
    background: var(--color-accent);
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    box-shadow: 0 12px 28px rgba(249, 122, 18, .2);
  }

  .listen-error {
    color: #ff6b61;
  }

  .chat {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background: rgba(20, 20, 23, .96);
    border-left: 1px solid var(--glass-border);
  }

  .chat > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 72px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--glass-border);
  }

  .chat > header div {
    display: grid;
    min-width: 0;
    gap: 3px;
  }

  .chat > header small {
    color: #ff9a4a;
    font-size: .65rem;
    font-weight: 750;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .chat > header strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat > header > span {
    flex: none;
    color: var(--color-dim);
    font-size: .72rem;
  }

  .messages {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    overflow-y: auto;
  }

  .messages > p {
    margin: auto;
    color: var(--color-dim);
    font-size: .82rem;
    line-height: 1.5;
    text-align: center;
  }

  :global(.chat-message) {
    display: grid;
    gap: 3px;
    margin: 0;
    font-size: .84rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  :global(.chat-message strong) {
    color: #ff9a4a;
    font-size: .7rem;
  }

  :global(.chat-message span) {
    color: #c4c4ca;
  }

  .chat form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    padding: 14px;
    border-top: 1px solid var(--glass-border);
  }

  .chat input {
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    color: var(--color-main);
    background: #0c0c0e;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    outline: 0;
  }

  .chat input:focus {
    border-color: rgba(249, 122, 18, .7);
  }

  .chat form button {
    min-height: 44px;
    padding: 0 16px;
    color: #1a0e02;
    background: var(--color-accent);
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
  }

  @media (max-width: 880px) {
    .room {
      grid-template-columns: 1fr;
    }

    .stage {
      min-height: 680px;
      padding-inline: 16px;
    }

    .art {
      width: min(54vh, 76vw, 400px);
    }

    .chat {
      min-height: 440px;
      border-top: 1px solid var(--glass-border);
      border-left: 0;
    }
  }
</style>
