---
import Layout from "../layouts/Layout.astro";
import { publicAsset } from "../public-asset";

const title = "Open in Soundsible";
const description =
  "Open a song shared from Soundsible in your own Soundsible player.";
---

<Layout title={title} description={description}>
  <main class="open-shell">
    <section class="open-card" aria-live="polite">
      <img class="open-logo" src={publicAsset("logo-app.png")} alt="" width="64" height="64" />

      <div id="loading">
        <p class="eyebrow">Soundsible</p>
        <h1>Opening your player…</h1>
      </div>

      <div id="track" hidden>
        <p class="eyebrow">Shared with you</p>
        <h1 id="track-title"></h1>
        <p id="track-artist" class="artist"></p>

        <div class="actions">
          <a id="open-desktop" class="primary" href="#">Open Soundsible desktop</a>
          <a id="open-youtube" class="secondary" href="#" target="_blank" rel="noreferrer">
            Open on YouTube
          </a>
        </div>

        <div class="divider"><span>or use your web player</span></div>
        <form id="instance-form">
          <label for="instance-url">Your Soundsible URL</label>
          <div class="url-row">
            <input
              id="instance-url"
              type="url"
              inputmode="url"
              autocomplete="url"
              placeholder="https://music.example/player/"
              required
            />
            <button type="submit">Open</button>
          </div>
          <p id="instance-error" class="error" hidden>
            Enter the full URL ending in /player/.
          </p>
          <p class="privacy">Saved in this browser for future Soundsible links.</p>
        </form>
      </div>

      <div id="register" hidden>
        <p class="eyebrow">Shared links</p>
        <h1>Use this Soundsible player?</h1>
        <p class="artist">
          Future song links will open directly on <strong id="instance-host"></strong>.
        </p>
        <button id="register-button" class="primary register-button" type="button">
          Use this player
        </button>
        <p class="privacy">This choice stays only in this browser.</p>
      </div>

      <div id="invalid" hidden>
        <p class="eyebrow">Soundsible</p>
        <h1>This link is not valid</h1>
        <p class="artist">Ask the sender to share the song again.</p>
        <a class="secondary home-link" href={import.meta.env.BASE_URL}>Go to Soundsible</a>
      </div>
    </section>
  </main>

  <script>
    import "../scripts/open-track";
  </script>
</Layout>

<style>
  .open-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 18px;
  }

  .open-card {
    width: min(100%, 480px);
    padding: 34px;
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    background: rgba(22, 22, 26, 0.9);
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(22px);
  }

  .open-logo {
    margin-bottom: 30px;
    border-radius: 17px;
    box-shadow: 0 12px 34px rgba(249, 122, 18, 0.18);
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: "Outfit Variable", sans-serif;
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 650;
    line-height: 1.02;
    text-wrap: balance;
  }

  .artist {
    margin: 12px 0 0;
    color: var(--color-dim);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .actions {
    display: grid;
    gap: 10px;
    margin-top: 30px;
  }

  .primary,
  .secondary,
  .url-row button {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 140ms ease, background 140ms ease;
  }

  .primary,
  .url-row button {
    border: 0;
    background: var(--color-accent);
    color: #111;
  }

  .secondary {
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.045);
    color: var(--color-main);
  }

  .primary:hover,
  .secondary:hover,
  .url-row button:hover {
    transform: translateY(-1px);
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 26px 0 20px;
    color: var(--color-dim);
    font-size: 0.78rem;
  }

  .divider::before,
  .divider::after {
    content: "";
    height: 1px;
    flex: 1;
    background: var(--glass-border);
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .url-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }

  input {
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    outline: none;
    background: rgba(0, 0, 0, 0.22);
    color: var(--color-main);
  }

  input:focus {
    border-color: rgba(249, 122, 18, 0.75);
  }

  .url-row button {
    padding: 0 18px;
    cursor: pointer;
  }

  .privacy,
  .error {
    margin: 9px 0 0;
    color: var(--color-dim);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .error {
    color: #ff8585;
  }

  .register-button {
    width: 100%;
    margin-top: 28px;
    cursor: pointer;
  }

  .home-link {
    margin-top: 28px;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 520px) {
    .open-card {
      padding: 26px 22px;
      border-radius: 24px;
    }

    .url-row {
      grid-template-columns: 1fr;
    }
  }
</style>
